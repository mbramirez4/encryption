<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info" strict="true" name="Log4j2Config">
    <Properties>
        <Property name="log_pattern">%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="app_log_root">logs</Property>
        <Property name="base_name">encryption_${hostName}</Property>
        <Property name="analysis_time">encryption.tiempos_${hostName}</Property>
        <Property name="analysis_performance">encryption.performance_${hostName}</Property>
    </Properties>
    <Appenders>
        <Console name="Console">
            <PatternLayout pattern="${log_pattern}"/>
        </Console>
        <RollingFile    name="FileLogger"
                        filePattern="${app_log_root}/${base_name}_%d{yyyy-MM-dd}_%03i.log"
                        append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
        </RollingFile>

        <RollingFile    name="FileLoggerTime"
                        filePattern="${app_log_root}/${analysis_time}_%d{yyyy-MM-dd}_%03i.log"
                        append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
        </RollingFile>

        <RollingFile    name="FileLoggerPerformance"
                        filePattern="${app_log_root}/${analysis_performance}_%d{yyyy-MM-dd}_%03i.log"
                        append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="FileLogger"/>
        </Root>

        <Logger name="main" level="debug" additivity="false">
            <AppenderRef ref="FileLogger"/>
        </Logger>

        <Logger name="times" level="debug" additivity="false">
            <AppenderRef ref="FileLoggerTime"/>
        </Logger>

        <Logger name="performance" level="debug" additivity="false">
            <AppenderRef ref="FileLoggerPerformance"/>
        </Logger>

    </Loggers>
</Configuration>